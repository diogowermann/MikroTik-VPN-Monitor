# MikroTik VPN Monitor - public ingestion-only reverse proxy example
#
# Replace the fictitious hostname, certificate paths and documentation IP
# allowlist before deployment. Do not expose local query endpoints here.

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name vpn-api.example.com;

    ssl_certificate /etc/nginx/tls/vpn-api.example.com/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/vpn-api.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    server_tokens off;
    client_max_body_size 1m;

    location = /api/v1/router/events {
        allow 192.0.2.10;
        deny all;

        limit_except POST {
            deny all;
        }

        proxy_pass http://127.0.0.1:8092;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_read_timeout 10s;
    }

    location = /api/v1/router/snapshot {
        allow 192.0.2.10;
        deny all;

        limit_except POST {
            deny all;
        }

        proxy_pass http://127.0.0.1:8092;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_read_timeout 10s;
    }

    location / {
        return 404;
    }
}
